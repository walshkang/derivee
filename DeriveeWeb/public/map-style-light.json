{
  "version": 8,
  "name": "Derivee Light",
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles://basemap.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#FFFFFF"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "basemap",
      "source-layer": "land",
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          "park", "#F2F5F2",
          "forest", "#F2F5F2",
          "cemetery", "#F2F5F2",
          "residential", "#FAFAFA",
          "commercial", "#F8F9FA",
          "#FFFFFF"
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water_polygons",
      "paint": {
        "fill-color": "#EDF2F7"
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "basemap",
      "source-layer": "ocean",
      "paint": {
        "fill-color": "#EDF2F7"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "basemap",
      "source-layer": "water_lines",
      "paint": {
        "line-color": "#CBD5E1",
        "line-width": 1
      }
    },
    {
      "id": "pier-polygons",
      "type": "fill",
      "source": "basemap",
      "source-layer": "pier_polygons",
      "paint": {
        "fill-color": "#F0F2F5"
      }
    },
    {
      "id": "street-polygons",
      "type": "fill",
      "source": "basemap",
      "source-layer": "street_polygons",
      "paint": {
        "fill-color": "#F0F2F5"
      }
    },
    {
      "id": "streets-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "streets",
      "filter": ["in", "kind", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#E2E8F0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 2, 14, 5]
      }
    },
    {
      "id": "streets-major",
      "type": "line",
      "source": "basemap",
      "source-layer": "streets",
      "filter": ["in", "kind", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#E4E7EB",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.5, 14, 3.5]
      }
    },
    {
      "id": "streets-secondary",
      "type": "line",
      "source": "basemap",
      "source-layer": "streets",
      "filter": ["in", "kind", "secondary", "tertiary"],
      "paint": {
        "line-color": "#ECEEF1",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1, 14, 2.5]
      }
    },
    {
      "id": "streets-minor",
      "type": "line",
      "source": "basemap",
      "source-layer": "streets",
      "filter": ["!in", "kind", "motorway", "trunk", "primary", "secondary", "tertiary", "rail"],
      "paint": {
        "line-color": "#F4F5F7",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 14, 1.5]
      }
    },
    {
      "id": "bridges",
      "type": "line",
      "source": "basemap",
      "source-layer": "bridges",
      "paint": {
        "line-color": "#CBD5E1",
        "line-width": 2
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#CBD5E1",
        "line-dasharray": [2, 2],
        "line-width": 1
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place_labels",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 11, 14, 15],
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "street_labels",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#94A3B8",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    }
  ]
}
