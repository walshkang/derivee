{
  "expo": {
    "name": "Dérivée",
    "slug": "derivee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.derivee.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F9F6"
      },
      "package": "com.derivee.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "derivee",
    "plugins": [
      "expo-router",
      [
        "@maplibre/maplibre-react-native",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Dérivée to use your location to uncover the map."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Dérivée to use your location in the background to uncover the map as you explore.",
          "locationAlwaysPermission": "Allow Dérivée to track your exploration even when the app is in the background.",
          "locationWhenInUsePermission": "Allow Dérivée to track your exploration while using the app.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-asset"
    ]
  }
}
