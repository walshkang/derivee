#!/usr/bin/env bash
set -e

# ==============================================================================
# Dérivée Local Ergonomic Bouncer: Pre-Commit Gate (<0.2s)
# Validates staged Swift code against First-Click Invariants (FC-1 to FC-10).
# Bypass for emergencies only: git commit --no-verify
# ==============================================================================

# Find staged Swift files in the native UI directory (exclude tests and docs)
STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=d | grep -E '^DeriveeNative/Derivee/.*\.swift$' || true)

if [ -z "$STAGED_SWIFT" ]; then
    exit 0
fi

ERRORS=0

for FILE in $STAGED_SWIFT; do
    # FC-5: Zero nested modal sheets on top of bottom sheets
    if [ "$FILE" = "DeriveeNative/Derivee/TransitRevealSheet.swift" ]; then
        if git show :"$FILE" | grep -n '\.sheet(item: \$inspectingArrival)' > /dev/null 2>&1; then
            echo "❌ [FC-5 Violation] in $FILE:"
            echo "   Nested .sheet(item: \$inspectingArrival) modal presentation is strictly prohibited."
            echo "   Use in-place transition hierarchy with onBack chevron (see design.md § 13)."
            ERRORS=$((ERRORS + 1))
        fi
    fi

    # FC-2: Zero raw database keys or telemetry acronyms in user Text() views
    if git show :"$FILE" | grep -En 'Text\(.*(TRIP |REALTIME AVL|trip_id)' > /dev/null 2>&1; then
        echo "❌ [FC-2 Violation] in $FILE:"
        echo "   Raw telemetry or database keys detected in Text(...) view."
        echo "   Use human operational proximity (e.g. '2 stops away • Approaching Lorimer St')."
        ERRORS=$((ERRORS + 1))
    fi

    # FC-4: Zero hardcoded row heights on dynamic timetable departure containers
    if [ "$FILE" = "DeriveeNative/Derivee/DepartureMatrixView.swift" ]; then
        if git show :"$FILE" | grep -n '\.frame(height: Self\.defaultRowHeight, alignment: \.top)' > /dev/null 2>&1; then
            echo "❌ [FC-4 Violation] in $FILE:"
            echo "   Hardcoded .frame(height: Self.defaultRowHeight) clamps dynamic wrapping departures."
            echo "   Use .fixedSize(horizontal: false, vertical: true) for dynamic vertical expansion."
            ERRORS=$((ERRORS + 1))
        fi
    fi

    # FC-7: Zero detent-coupled state wipes (onClearRouteInspection inside .onDisappear)
    if [ "$FILE" = "DeriveeNative/Derivee/GuidewayRunInspector.swift" ] || [ "$FILE" = "DeriveeNative/Derivee/SurfaceRunInspector.swift" ]; then
        if git show :"$FILE" | grep -A 3 -n '\.onDisappear' | grep 'onClearRouteInspection' > /dev/null 2>&1; then
            echo "❌ [FC-7 Violation] in $FILE:"
            echo "   onClearRouteInspection inside .onDisappear wipes map route telemetry on detent changes."
            echo "   Teardown must be gated strictly on explicit commuter exit intent (see DERIVEE_INVARIANTS.md FC-7)."
            ERRORS=$((ERRORS + 1))
        fi
    fi

    # FC-11: Header grabber clearance on sheets with visible drag indicators (>= 20pt)
    if [ "$FILE" = "DeriveeNative/Derivee/AmbientDriftControlCard.swift" ]; then
        if git show :"$FILE" | grep -En '\.padding\(\.top, ([0-9]|1[0-9])\)' > /dev/null 2>&1; then
            echo "❌ [FC-11 Violation] in $FILE:"
            echo "   Header top padding < 20pt detected on sheet with visible drag indicator."
            echo "   Must specify >= 20pt (e.g. .padding(.top, 24)) for grabber clearance (see design.md § 13.3)."
            ERRORS=$((ERRORS + 1))
        fi
    fi

    # FC-12: Zero truncated status/escalation banners (multi-line vertical expansion required)
    if [ "$FILE" = "DeriveeNative/Derivee/AmbientDriftControlCard.swift" ]; then
        if git show :"$FILE" | grep -n 'var escalationBanner' > /dev/null 2>&1; then
            if ! git show :"$FILE" | grep -n '\.fixedSize(horizontal: false, vertical: true)' > /dev/null 2>&1; then
                echo "❌ [FC-12 Violation] in $FILE:"
                echo "   escalationBanner detected without .fixedSize(horizontal: false, vertical: true)."
                echo "   Must allow multi-line expansion without horizontal ellipsis truncation."
                ERRORS=$((ERRORS + 1))
            fi
        fi
    fi

    # FC-17: Zero static line widths on transit corridors (must use zoom-interpolated expressions)
    if [ "$FILE" = "DeriveeNative/Derivee/MapView.swift" ]; then
        if git show :"$FILE" | grep -En '(subway|lrt|ribbon|trench).*\.lineWidth = NSExpression\(forConstantValue: [0-9]' > /dev/null 2>&1; then
            echo "❌ [FC-17 Violation] in $FILE:"
            echo "   Static line width expression detected on transit corridor layer."
            echo "   Must use zoom-interpolated expression (forMLNInterpolating: .zoomLevelVariable) per Research Doc 22 §4.2."
            ERRORS=$((ERRORS + 1))
        fi
    fi
done

if [ $ERRORS -gt 0 ]; then
    echo ""
    echo "🚨 [Local Bouncer] Commit aborted due to $ERRORS Ergonomic Invariant violation(s)."
    echo "   Fix the violation(s) above or run './scripts/verify-ux.sh' to inspect."
    echo "   Emergency bypass: git commit -n (or --no-verify)"
    exit 1
fi

exit 0
