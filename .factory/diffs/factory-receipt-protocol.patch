diff --git a/.factory/README.md b/.factory/README.md
new file mode 100644
index 0000000..27ac958
--- /dev/null
+++ b/.factory/README.md
@@ -0,0 +1,8 @@
+# .factory
+
+Workspace directory for wave execution contracts, schemas, and receipts.
+- schemas/: Machine-readable schemas defining execution protocols.
+- active_brief.json: Wave contract written by orchestrator before execution.
+- receipt.json: Structured execution receipt returned upon wave completion.
+- diffs/: Wave patch files (<wave_id>.patch) for verification and audit.
+- scratch/: Ephemeral wave logs and temporary diagnostics.
diff --git a/.factory/active_brief.json b/.factory/active_brief.json
new file mode 100644
index 0000000..454f896
--- /dev/null
+++ b/.factory/active_brief.json
@@ -0,0 +1,16 @@
+{
+  "wave_id": "factory-receipt-protocol",
+  "scope": {
+    "allowed_files": [
+      ".factory/**"
+    ]
+  },
+  "limits": {
+    "max_lines_changed": 150
+  },
+  "acceptance": [
+    ".factory/ structure exists exactly as specified",
+    "receipt.json validates against the schema",
+    "final response is the receipt JSON (<150 tokens)"
+  ]
+}
diff --git a/.factory/diffs/.gitkeep b/.factory/diffs/.gitkeep
new file mode 100644
